{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "sortImports": {
    "internalPattern": ["@/"]
  },
  "ignorePatterns": [
    "android/**",
    "dist/**",
    "coverage/**",
    ".expo/**",
    "fixtures/receipts/**",
    "yarn.lock"
  ]
}
